<section class="section container" id="how">
  <span class="eyebrow">{{ section.settings.eyebrow }}</span>
  <h2 class="steps-h">{{ section.settings.heading }}</h2>
  <div class="steps">
    {%- for block in section.blocks -%}
      <div class="step" {{ block.shopify_attributes }}>
        <b>{{ forloop.index }}</b>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "How ordering works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps to your bag" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pick your bags" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Add bags to your cart and set the quantities." }
      ]
    }
  ],
  "presets": [{ "name": "Steps" }]
}
{% endschema %}
