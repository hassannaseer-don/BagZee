<section class="section container">
  <div class="sec-head">
    <span class="eyebrow">Collection</span>
    <h1 class="page-h">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
  </div>

  <div class="toolbar">
    {%- if section.settings.chips != blank -%}
      <nav class="chips" aria-label="Categories">
        <a class="chip" href="{{ routes.all_products_collection_url }}"{% if collection.handle == 'all' %} aria-current="page"{% endif %}>All</a>
        {%- for link in section.settings.chips.links -%}
          <a class="chip" href="{{ link.url }}"{% if link.current or link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
    {%- if collection.products_count > 1 -%}
      <label class="visually-hidden" for="sort-by">Sort by</label>
      <select class="sel sort" id="sort-by" data-sort-select>
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.per_page -%}
    <p class="count">{{ collection.products_count }} {% if collection.products_count == 1 %}bag{% else %}bags{% endif %}</p>
    <div class="grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="empty">No products in this collection yet.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pager" aria-label="Pagination">
        {%- if paginate.previous -%}<a class="btn line" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
        <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="btn line" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 36, "step": 4, "default": 12 },
    { "type": "link_list", "id": "chips", "label": "Category buttons", "info": "A menu whose links are your collections.", "default": "main-menu" }
  ]
}
{% endschema %}
