<section class="hero">
  <div class="container hero-grid">
    <div>
      <div class="pills">
        {%- if section.settings.pill_1 != blank -%}<span class="pill gold">{{ section.settings.pill_1 }}</span>{%- endif -%}
        {%- if section.settings.pill_2 != blank -%}<span class="pill soft">{{ section.settings.pill_2 }}</span>{%- endif -%}
      </div>
      <h1>{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h1>
      <p class="lead">{{ section.settings.text }}</p>
      <div class="hero-cta">
        {%- if section.settings.button_label != blank -%}
          <a class="btn primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
        {%- capture wa_order -%}Hi {{ shop.name }}, I would like to place an order.{%- endcapture -%}
        <a class="btn wa" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ wa_order | url_encode }}" target="_blank" rel="noopener">{% render 'icon', name: 'wa' %}Order on WhatsApp</a>
      </div>
    </div>
    <div class="hero-photo">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 800, 1000', sizes: '(min-width: 900px) 45vw, 100vw', alt: section.settings.image.alt | default: shop.name }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if section.settings.product != blank -%}
        <a class="hero-chip" href="{{ section.settings.product.url }}">
          <div><span>Featured</span><strong>{{ section.settings.product.title }}</strong></div>
          <i class="go">{% render 'icon', name: 'arrow' %}</i>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "pill_1", "label": "Label 1", "default": "Handcrafted bags" },
    { "type": "text", "id": "pill_2", "label": "Label 2", "default": "Pre-orders open" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elegance You Carry." },
    { "type": "text", "id": "heading_accent", "label": "Heading second line (italic)", "default": "Crafted by bag.Ze" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Totes, crossbody bags, backpacks, duffles and pouches made for everyday life. Choose yours and order in one tap." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "product", "id": "product", "label": "Featured product" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
