{%- assign current = product.selected_or_first_available_variant -%}
<section class="section container product-page" data-product>
  <div class="pdp">
    <div class="pdp-media">
      <div class="pdp-main" data-main>
        {%- if product.featured_media != blank -%}
          {{ product.featured_media | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 750, 1000', sizes: '(min-width: 900px) 50vw, 100vw', alt: product.featured_media.alt | default: product.title }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pdp-thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button type="button" class="thumb" data-thumb="{{ media.preview_image | image_url: width: 1000 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Photo {{ forloop.index }} of {{ product.title | escape }}">
                {{ media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp-info">
      {%- if product.type != blank -%}<span class="eyebrow">{{ product.type }}</span>{%- endif -%}
      <h1 class="page-h">{{ product.title }}</h1>
      {% render 'price', product: product %}

      {%- form 'product', product, id: 'product-form', class: 'pdp-form' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ current.id }}">
        {%- else -%}
          <div class="field">
            <label for="variant-id">{% for option in product.options %}{{ option }}{% unless forloop.last %} / {% endunless %}{% endfor %}</label>
            <select class="sel" id="variant-id" name="id">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}"{% if variant == current %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} · {{ variant.price | money }}{% unless variant.available %} (sold out){% endunless %}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
        <div class="field qty-field">
          <label for="quantity">Quantity</label>
          <input class="qty-input" id="quantity" type="number" name="quantity" value="1" min="1" max="20" inputmode="numeric">
        </div>
        {%- if current.available -%}
          <button class="btn primary block" type="submit" name="add">Add to cart</button>
        {%- else -%}
          <button class="btn primary block" type="button" disabled>Sold out</button>
        {%- endif -%}
      {%- endform -%}

      {%- capture wa_msg -%}Hi {{ shop.name }}, I would like to order the {{ product.title }} at {{ current.price | money_without_currency }}. {{ shop.url }}{{ product.url }}{%- endcapture -%}
      <a class="btn wa block" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ wa_msg | url_encode }}" target="_blank" rel="noopener">{% render 'icon', name: 'wa' %}Order on WhatsApp</a>

      <p class="pay-adv">Cash on delivery needs a {{ settings.advance_pct }}% advance. Your order is confirmed once the advance is received.</p>

      {%- if product.description != blank -%}
        <div class="rte pdp-desc">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": []
}
{% endschema %}
