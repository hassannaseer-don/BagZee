<section class="section container proof-sec">
  <div class="proof-card">
    <span class="eyebrow">Payment screenshot</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="pay-lead">{{ section.settings.text }}</p>
    {%- if settings.proof_endpoint != blank -%}
      <form id="proof-form" class="proof-form" data-endpoint="{{ settings.proof_endpoint }}" novalidate>
        <div class="field"><label for="pf-order">Order number</label><input id="pf-order" name="order" placeholder="#1001" autocomplete="off"></div>
        <div class="field"><label for="pf-name">Full name</label><input id="pf-name" name="name" autocomplete="name"></div>
        <div class="field"><label for="pf-phone">Phone</label><input id="pf-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel"></div>
        <div class="field"><label for="pf-file">Payment screenshot</label><input id="pf-file" name="file" type="file" accept="image/*"><img id="pf-prev" alt="Preview of your payment screenshot" hidden></div>
        <button class="btn primary" type="submit">Send screenshot</button>
        <p class="status" id="pf-status" role="status" aria-live="polite"></p>
      </form>
    {%- else -%}
      {%- capture wa_proof -%}Hi {{ shop.name }}, this is my payment screenshot for my order. Order number: {%- endcapture -%}
      <p><a class="btn wa" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ wa_proof | url_encode }}" target="_blank" rel="noopener">{% render 'icon', name: 'wa' %}Send screenshot on WhatsApp</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Payment screenshot form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send your payment screenshot" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "After you pay by Easypaisa, JazzCash, NayaPay or bank transfer, add your order number and a screenshot of the payment. We confirm your order once we receive it." }
  ],
  "presets": [{ "name": "Payment screenshot form" }]
}
{% endschema %}
