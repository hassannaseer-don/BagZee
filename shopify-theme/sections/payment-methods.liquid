<section class="band section" id="payment">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="pay-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="pay-grid">
      {%- for block in section.blocks -%}
        <article class="pay-card" {{ block.shopify_attributes }}>
          <span class="pi">{% render 'icon', name: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.details != blank -%}
            <div class="pay-det">{{ block.settings.details }}</div>
          {%- elsif block.settings.advance -%}
            <p class="pay-adv">{{ settings.advance_pct }}% advance required to confirm</p>
          {%- else -%}
            <p class="pay-soon">Account details are shared when we confirm your order.</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    <p class="pay-proof-link"><a href="{{ section.settings.proof_page.url | default: '#' }}">Already paid? Send your payment screenshot</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Payment methods",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Payment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pay the way that suits you" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose a method at checkout. We confirm the total and the delivery date with you before you pay." },
    { "type": "page", "id": "proof_page", "label": "Payment screenshot page" }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Payment method",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "wallet",
          "options": [
            { "value": "pouch", "label": "Cash" },
            { "value": "wallet", "label": "Wallet" },
            { "value": "bank", "label": "Bank" }
          ] },
        { "type": "text", "id": "title", "label": "Name", "default": "Easypaisa" },
        { "type": "textarea", "id": "text", "label": "How it works", "default": "Send the order total to our Easypaisa account, then send the payment screenshot." },
        { "type": "richtext", "id": "details", "label": "Account details", "info": "Account title and number. Shown with the method when filled in." },
        { "type": "checkbox", "id": "advance", "label": "Cash on delivery (show the advance notice)", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Payment methods" }]
}
{% endschema %}
