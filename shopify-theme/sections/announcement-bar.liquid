{%- if section.settings.text != blank -%}
<div class="announce">
  {{ section.settings.text }}
  {%- if section.settings.link_label != blank and section.settings.link != blank %} <a href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{% endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Pre-orders open · Pick your bags and order today" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "How ordering works" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
