{%- comment -%}
  Price with a crossed-out compare-at price and a discount badge value.
  Usage: {% render 'price', product: product %}
  The crossed-out price only shows when you set "Compare-at price" on the product in Shopify admin.
{%- endcomment -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price and product.available -%}{%- assign on_sale = true -%}{%- endif -%}
<span class="price-row">
  <span class="price">
    {%- if product.price_varies %}From {% endif -%}{{ product.price | money }}
  </span>
  {%- if on_sale -%}
    <s class="was"><span class="visually-hidden">Regular price </span>{{ product.compare_at_price | money }}</s>
  {%- endif -%}
</span>
