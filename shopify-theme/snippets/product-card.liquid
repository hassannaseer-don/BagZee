{%- comment -%}
  Product card. Usage: {% render 'product-card', product: product %}
{%- endcomment -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price and product.available -%}
  {%- assign on_sale = true -%}
  {%- assign off = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
{%- endif -%}
<article class="card">
  <a class="tile" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw', alt: product.featured_image.alt | default: product.title }}
    {%- endif -%}
    {%- if on_sale -%}<span class="sale">-{{ off }}%</span>{%- endif -%}
    {%- unless product.available -%}<span class="sale sold">Sold out</span>{%- endunless -%}
  </a>
  <div class="card-body">
    {%- if product.type != blank -%}<span class="cat-l">{{ product.type }}</span>{%- endif -%}
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% render 'price', product: product %}
    {%- if product.available -%}
      {%- if product.variants.size == 1 -%}
        {%- form 'product', product, class: 'card-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button class="btn dark" type="submit">Add to cart</button>
        {%- endform -%}
      {%- else -%}
        <a class="btn dark" href="{{ product.url }}">Choose options</a>
      {%- endif -%}
    {%- else -%}
      <a class="btn line" href="{{ product.url }}">View</a>
    {%- endif -%}
  </div>
</article>
