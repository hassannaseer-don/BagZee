<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body{margin:0;min-height:100vh;display:grid;place-items:center;background:#2c1e13;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;padding:24px;text-align:center}
    h1{font-family:'Playfair Display',serif;font-size:clamp(2.4rem,9vw,4rem);margin:0 0 12px}
    p{color:#d6d3d1;max-width:42ch;margin:0 auto 24px}
    form{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
    input{min-height:48px;padding:0 16px;border-radius:999px;border:0;font-size:1rem}
    button{min-height:48px;padding:0 24px;border-radius:999px;border:0;background:#8c643e;color:#fff;font-weight:600;font-size:1rem;cursor:pointer}
  </style>
  {{ content_for_header }}
</head>
<body>
  <div>
    <h1>{{ shop.name }}</h1>
    <p>{{ 'general.password_message' | t }}</p>
    {% form 'storefront_password' %}
      <input type="password" name="password" placeholder="{{ 'general.password' | t }}" aria-label="{{ 'general.password' | t }}" required>
      <button type="submit">{{ 'general.enter' | t }}</button>
      {{ form.errors | default_errors }}
    {% endform %}
  </div>
  {{ content_for_layout }}
</body>
</html>
